# Optional residential proxy for Blueground if you get rate-limited.
# Format: http://user:pass@host:port
HTTP_PROXY=

# Per-domain rate limit (requests per second).
SCRAPER_RATE_LIMIT_RPS=1.0

# Logging level
LOG_LEVEL=INFO

# Shared-secret guard for /scrape. Leave blank for local dev (open endpoint).
# In production (HF Spaces), set this to a random string and configure the
# frontend with the same value via VITE_SCRAPER_TOKEN.
DEMO_TOKEN=
